doctype html 
html(lang='en')
    head
        style
            include style.css
        title Countries and Capitals
    body 
        h1 Countries and Capitals
        div.navbar
            ul.navUL
                li.navLI 
                    a(href='/home') Home
                li.navLI
                    a(href='/capitals') Capitals
            
                li.navLI 
                    a(href='populous') Populous 
            
                li.navLI
                    a(href='regions') Regions
        div.dataList
            ol
                each country in countries
                    li #{country.name.common} - #{country.capital}
                    br